+++ b/backend/src/prisma/org-field-sources-seed.js
@@ -0,0 +1,273 @@
+/**
+ * Per-organisation `fieldSources` for sample seed rows (Story 11.5).
+ * Keys: camelCase per ORGANISATION_FIELD_SOURCE_KEYS. Omitted keys: no defensible URL or capability UNKNOWN.
+ * Location/capacity: English Wikipedia where available (HTTP 200, infobox / article text).
+ * Duplicate URLs across keys on the same org are allowed when one page supports multiple claims.
+ */
+
+const W = (url) => url;
