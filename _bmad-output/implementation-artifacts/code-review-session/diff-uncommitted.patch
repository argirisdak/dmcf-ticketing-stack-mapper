@@ -0,0 +1,13 @@
+/**
+ * Derive compare grid UI phase from parallel system queries (after IDs are non-empty).
+ * @param {import('@tanstack/react-query').UseQueryResult[]} queries
+ * @returns {'loading' | 'insufficient' | 'ready'}
+ */
+export function getSystemComparePhase(queries) {
+  if (queries.length === 0) return 'insufficient'
+  const loading = queries.some((q) => q.isPending)
+  if (loading) return 'loading'
+  const successCount = queries.filter((q) => q.isSuccess).length
+  if (successCount < 2) return 'insufficient'
+  return 'ready'
+}
