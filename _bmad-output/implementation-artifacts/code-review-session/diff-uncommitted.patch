@@ -0,0 +1,34 @@
+import { describe, it, expect } from 'vitest'
+import { getSystemComparePhase } from './system-compare-view-state.js'
+
+function mockPending() {
+  return { isPending: true, isSuccess: false, isError: false }
+}
+
+function mockSuccess() {
+  return { isPending: false, isSuccess: true, isError: false }
+}
+
+function mockError() {
+  return { isPending: false, isSuccess: false, isError: true }
+}
+
+describe('getSystemComparePhase', () => {
+  it('returns insufficient when no queries', () => {
+    expect(getSystemComparePhase([])).toBe('insufficient')
+  })
+
+  it('returns loading when any query is pending', () => {
+    expect(getSystemComparePhase([mockSuccess(), mockPending()])).toBe('loading')
+  })
+
+  it('returns insufficient when fewer than 2 succeed after settle', () => {
+    expect(getSystemComparePhase([mockSuccess(), mockError()])).toBe('insufficient')
+    expect(getSystemComparePhase([mockError(), mockError()])).toBe('insufficient')
+  })
+
+  it('returns ready when at least 2 succeed', () => {
+    expect(getSystemComparePhase([mockSuccess(), mockSuccess()])).toBe('ready')
+    expect(getSystemComparePhase([mockSuccess(), mockSuccess(), mockError()])).toBe('ready')
+  })
+})
